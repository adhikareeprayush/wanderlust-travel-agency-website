# Frontend: leave blank for the Vite proxy or same-origin production hosting.
VITE_API_URL=

# Server
PORT=5000
CLIENT_URL=http://localhost:5173
# Replica set required for atomic booking confirmation.
MONGODB_URI=mongodb://127.0.0.1:27017/wanderlust?replicaSet=rs0
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRES_IN=7d

# Email: leave blank for local log previews; submissions still persist.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Wanderlust Travel <hello@wanderlust.travel>

# ImageKit image storage (optional locally; without it the bundled /images are used).
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_FOLDER=/wanderlust
VITE_IMAGEKIT_URL_ENDPOINT=
