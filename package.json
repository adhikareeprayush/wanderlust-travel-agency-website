{
  "name": "wanderlust-travel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "seed": "node server/scripts/seed.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server/index.js",
    "setup": "node server/scripts/setup.js",
    "test": "node --test server/tests/*.test.js",
    "create-admin": "node server/scripts/create-admin.js",
    "images:sync": "node server/scripts/imagekit-sync.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.4",
    "nodemailer": "^7.0.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-iframe": "^1.8.5",
    "react-router-dom": "^7.9.1",
    "stripe": "^18.3.0",
    "swiper": "^11.2.10",
    "tailwindcss": "^4.1.12",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
