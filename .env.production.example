# Production settings for docker-compose.prod.yml. On the server:
#   cp .env.production.example .env.production
# then fill in the blanks. Never commit .env.production.

CLIENT_URL=https://travel.prayushadhikari.com.np

# MongoDB Atlas. Keep the database name (/wanderlust) before the "?".
# In Atlas > Network Access, allow your VPS's public IP address.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.bhz6l.mongodb.net/wanderlust?retryWrites=true&w=majority&appName=Cluster0

# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ImageKit image storage. The private key must only live on the server.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/vboscqy9oj
IMAGEKIT_PUBLIC_KEY=public_f0Nfolj2Ujz/f7eOTgdFx6XxVyM=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_FOLDER=/wanderlust

# Email (optional). Without SMTP, messages are only written to the logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Wanderlust Travel <hello@travel.prayushadhikari.com.np>
